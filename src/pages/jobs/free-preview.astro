---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE, countries } from '../../data';

const featuredCountries = countries.filter((country) => country.priority === 'Launch');
---
<BaseLayout
  title="Weekly Relocation Jobs Newsletter on Substack | Relocate Works"
  description="Learn how Relocate Works researches weekly international relocation opportunities and publishes confirmed and potential support signals on Substack. The website itself is an informational relocation resource."
  canonicalPath="/jobs/free-preview"
>
  <Header />
  <main class="rw-main rw-weekly-page">
    <section class="rw-weekly-hero" aria-labelledby="weekly-page-title">
      <div class="container rw-weekly-hero-grid">
        <div class="rw-weekly-hero-content">
          <span class="rw-kicker"><span class="rw-kicker-dot" aria-hidden="true"></span> RELOCATE WORKS WEEKLY JOBS</span>
          <h1 id="weekly-page-title">Find international opportunities with <em>better evidence.</em></h1>
          <p>Get weekly research on international vacancies, with original employer links and clear distinctions between confirmed assistance and potential opportunities.</p>
          <div class="rw-weekly-hero-actions">
            <a class="rw-btn rw-btn-primary" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Subscribe on Substack <span aria-hidden="true">↗</span></a>
            <a class="rw-weekly-text-link" href="#how-we-research">How we review jobs <span aria-hidden="true">↓</span></a>
          </div>
          <p class="rw-weekly-editorial-note">Job roundups and application links are published on Substack. This site remains a free relocation research library.</p>
        </div>
        <div class="rw-weekly-benefit-panel" aria-label="Inside the weekly newsletter">
          <span class="rw-weekly-panel-label">WHAT'S INSIDE</span>
          <div><span class="rw-weekly-benefit-icon" aria-hidden="true">01</span><div><strong>Original job links</strong><p>Go straight to the employer's advertised opportunity when available.</p></div></div>
          <div><span class="rw-weekly-benefit-icon" aria-hidden="true">02</span><div><strong>Clear support evidence</strong><p>See what a vacancy confirms—and what still needs checking.</p></div></div>
          <div><span class="rw-weekly-benefit-icon" aria-hidden="true">03</span><div><strong>Practical research notes</strong><p>Read relevant eligibility and relocation considerations.</p></div></div>
        </div>
      </div>
    </section>

    <section class="section section-white weekly-evidence-section" id="how-we-research" aria-labelledby="weekly-evidence-title">
      <div class="container narrow">
        <div class="section-heading weekly-evidence-heading">
          <div>
            <span class="mini-eyebrow">How to interpret the newsletter</span>
            <h2 id="weekly-evidence-title">Understand the evidence, not a sponsorship score.</h2>
            <p class="rw-weekly-evidence-intro">Our labels distinguish what a specific vacancy explicitly offers from employer-level signals that still need confirmation.</p>
          </div>
        </div>
        <div class="process-grid">
          <div class="process-card">
            <span class="icon-circle">1</span>
            <h3>Confirmed support</h3>
            <p>The specific vacancy explicitly states that visa, work-permit or international relocation support is available. The newsletter identifies exactly which type is advertised. This is not a guarantee of an offer or visa.</p>
          </div>
          <div class="process-card">
            <span class="icon-circle">2</span>
            <h3>Potential support</h3>
            <p>Evidence suggests the employer has international-hiring capacity, but support for the individual vacancy has not been confirmed. Ask the recruiter before relying on sponsorship.</p>
          </div>
          <div class="process-card">
            <span class="icon-circle">3</span>
            <h3>Check before applying</h3>
            <p>Vacancies and visa rules can change quickly. Reopen the original employer listing, confirm the job is still available, and review current official rules for your personal circumstances.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="rw-weekly-guides" aria-labelledby="weekly-guides-title">
      <div class="container">
        <div class="rw-weekly-guides-head">
          <div><span class="rw-kicker">YOUR NEXT MOVE</span><h2 id="weekly-guides-title">Explore the destination, too.</h2>
          <p>Use our free country guides to research visa routes, salaries, taxes and everyday life. Guide availability does not imply vacancies in this week's newsletter.</p></div>
          <a class="rw-weekly-text-link" href="/countries">Browse all {countries.length} country guides <span aria-hidden="true">↗</span></a>
        </div>
        <div class="rw-weekly-guide-links">
          {featuredCountries.map((country) => <a href={'/countries/' + country.slug} aria-label={'Read the ' + country.name + ' relocation guide'}><span class="rw-weekly-guide-flag" aria-hidden="true">{country.flag}</span><span>{country.name}</span><span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </section>

    <section class="rw-weekly-bottom-cta" aria-labelledby="weekly-bottom-title">
      <div class="container rw-weekly-bottom-inner">
        <div>
          <span class="rw-kicker">THE WEEKLY RELOCATION LETTER</span>
          <h2 id="weekly-bottom-title">Get the research in your inbox.</h2>
          <p>Explore this week's verified research and future editions on our Substack publication.</p>
        </div>
        <div class="rw-weekly-bottom-actions">
          <a class="rw-btn rw-btn-primary" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Subscribe on Substack <span aria-hidden="true">↗</span></a>
          <a class="rw-weekly-text-link" href="/guides">Browse free relocation guides <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SITE } from '../data';
import '../toolkit.css';


---
<BaseLayout
  title="Relocate Works Newsletter Membership — Plans & Benefits"
  description="Compare newsletter membership benefits and check current prices and available plans directly on the Relocate Works Substack checkout."
  canonicalPath="/pricing"
>
  <Header />
  <main>
    <section class="page-hero page-hero-gradient compact-hero pricing-hero">
      <div class="container narrow">
        <span class="eyebrow">Newsletter membership</span>
        <h1>Explore free relocation guides. Subscribe for weekly jobs on Substack.</h1>
        <p class="lead">Review the newsletter benefits below. Current prices, plan availability, taxes and billing terms must be confirmed on Substack before subscribing.</p>
      </div>
    </section>

    <section id="pricing" class="section section-white">
      <div class="container"><p class="rw-tool-warn">Both paid-plan buttons open the same Substack publication. Choose and verify the plan, final charge, renewal terms and benefits there before payment.</p></div>
      <div class="container pricing-grid-full">
        <article class="pricing-card-full">
          <span class="badge badge-blue">Monthly</span>
          <h2>Monthly option</h2>
          <p>Best for candidates who want to test the full weekly sponsor job intelligence list before committing.</p>
          <ul class="check-list">
            <li>Full weekly sponsor-friendly job list</li>
            <li>Direct apply links</li>
            <li>Confirmed/Potential evidence notes</li>
            <li>Practical relocation planning notes</li>
            <li>Archive access while subscribed</li>
          </ul>
          <a class="button" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Review monthly options on Substack</a>
        </article>

        <article class="pricing-card-full featured-pricing-card">
          <span class="badge badge-success">Annual membership</span>
          <h2>Annual option</h2>
          <p>Best for serious candidates preparing to apply abroad over the next 6–12 months.</p>
          <ul class="check-list">
            <li>Everything in monthly access</li>
            <li>Check annual billing terms at Substack checkout</li>
            <li>Monthly templates or checklists when available</li>
            <li>Country and industry priority polls</li>
            <li>Confirm current price and renewal terms on Substack</li>
          </ul>
          <a class="button" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Review annual options on Substack</a>
        </article>

        <article class="pricing-card-full muted-pricing-card">
          <span class="badge badge-warning">Free</span>
          <h2>$0</h2>
          <p>Learn about the newsletter and browse the site's free country guides before subscribing.</p>
          <ul class="check-list">
            <li>Newsletter overview</li>
            <li>Country and industry breakdowns</li>
            <li>Public relocation guides</li>
            <li>Substack free posts</li>
            <li>No full apply-link list</li>
          </ul>
          <a class="button-ghost" href="/jobs/free-preview">Learn about the newsletter</a>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container split-feature">
        <div class="content-block">
          <span class="mini-eyebrow">What you get</span>
          <h2>Paid access is for weekly job intelligence.</h2>
          <p>Paid members get the full weekly sponsor-friendly job list, direct apply links, sponsor status, confirmed/potential evidence notes, visa pathway notes, salary notes when available, practical planning notes, and practical application guidance.</p>
        </div>
        <div class="content-block warning-block">
          <span class="mini-eyebrow">What you do not get</span>
          <h2>Clear research boundaries.</h2>
          <p>Relocate Works helps you research sponsor-friendly opportunities faster. Final eligibility, visa support, and hiring decisions depend on each employer and official immigration rules.</p>
          <a class="inline-link" href="/terms">Read full subscription terms →</a>
        </div>
      </div>
    </section>
    <CTA />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data';
---
<BaseLayout
  title="Contact RelocateAtlas — Questions, Feedback and Partnership Requests"
  description="Contact RelocateAtlas for feedback, correction requests, partnership questions, relocation resource suggestions, and weekly visa sponsor job list inquiries."
  canonicalPath="/contact"
>
  <Header />
  <main>
    <section class="page-hero page-hero-gradient">
      <div class="container">
        <span class="eyebrow">Contact</span>
        <h1>Contact RelocateAtlas.</h1>
        <p class="lead">Have feedback, a correction, a country request, a relocation resource suggestion, or a question about the paid weekly sponsor job list? Send a message and include clear context.</p>
      </div>
    </section>
    <section class="section">
      <div class="container prose">
        <h2>Best ways to contact us</h2>
        <p>
          RelocateAtlas is an early-stage project, so contact may be handled manually. The fastest way to get a useful reply is to include a clear subject, the country or page you are asking about, and the specific issue or request.
        </p>
        <div class="detail-grid">
          <div><strong>General questions</strong><span>Ask about the website, newsletter, country guides, job research format, or future product direction.</span></div>
          <div><strong>Corrections</strong><span>Send outdated visa notes, broken links, incorrect country details, or salary/cost information that should be reviewed.</span></div>
          <div><strong>Country requests</strong><span>Suggest new countries, cities, visa routes, job sectors, or relocation topics that should be added.</span></div>
          <div><strong>Partnerships</strong><span>Relocation companies, career services, immigration professionals, and employer brands can contact us about possible collaboration.</span></div>
        </div>

        <h2>Email</h2>
        <p>
          Current contact email: <strong>{SITE.email}</strong>
        </p>
        <p>
          If you are reporting a correction, please include the page URL, the exact section, the correction you recommend, and a source if available.
        </p>

        <h2>Questions about visa or immigration advice</h2>
        <p>
          RelocateAtlas cannot provide personalized visa advice, legal immigration advice, eligibility assessment, document review, or official application support. For personal immigration matters, contact official government sources or qualified immigration professionals.
        </p>

        <h2>Questions about jobs</h2>
        <p>
          RelocateAtlas does not employ candidates, represent employers, or guarantee sponsor availability. If a job is mentioned in a future job list, candidates must verify details directly with the employer or recruiter before applying.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { SITE, countries, industries } from '../data';
const launchCountries = countries.filter((country) => country.priority === 'Launch');

---
<BaseLayout
  title="Visa Sponsor Jobs — Weekly Multi-Industry Job Intelligence | Relocate Works"
  description="Subscribe to Relocate Works for weekly visa sponsor jobs across tech, healthcare, engineering, finance, education, hospitality, and skilled roles. Founding price: $9/month or $49/year."
  canonicalPath="/visa-sponsor-jobs"
>
  <Header />
  <main>
    <section class="hero hero-premium">
      <div class="hero-visual-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Weekly sponsor-friendly job intelligence</span>
          <h1>Understand visa sponsorship before you apply abroad.</h1>
          <p class="lead">
            Relocate Works publishes weekly sponsor-friendly job intelligence across high-demand global industries, with support evidence, practical planning notes, and direct apply links for paid members.
          </p>
          <div class="hero-actions">
            <a class="button button-large" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Subscribe on Substack</a>
            <a class="button-ghost button-large" href="/jobs/free-preview">Learn About the Newsletter</a>
          </div>
          <div class="trust-row" aria-label="Pricing summary">
            <span>$9/month</span>
            <span>$49/year founding</span>
            <span>Public newsletter available</span>
          </div>
        </div>
        <div class="hero-dashboard" id="sample">
          <div class="dashboard-topbar"><span></span><span></span><span></span><strong>How the newsletter works</strong></div>
          <div class="dashboard-card featured-job">
            <span class="badge badge-blue">Substack only</span>
            <h2>Weekly international job roundup</h2>
            <p class="job-meta">Verified evidence notes · Dated editions · Links to original vacancies</p>
            <p>Confirmed = the job itself states support. Potential = employer-level evidence only. Neither promises sponsorship for any applicant.</p>
            <p>Relocate Works website is an information resource; it does not host live job listings or applications.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-white">
      <div class="container">
        <div class="section-heading centered">
          <span class="mini-eyebrow">What subscribers receive</span>
          <h2>Not just job links. Apply-ready job intelligence.</h2>
          <p>Start with public newsletter editions. Paid members unlock the full weekly list with stronger context than a normal job board.</p>
        </div>
        <div class="process-grid">
          <div class="process-card">
            <span class="icon-circle">✓</span>
            <h3>Visa sponsor signals</h3>
            <p>We prioritize jobs with sponsorship, relocation, work permit, accredited employer, skilled worker, or international hiring signals.</p>
          </div>
          <div class="process-card">
            <span class="icon-circle">★</span>
            <h3>Multi-industry coverage</h3>
            <p>Tech, QA, data, healthcare, engineering, trades, finance, accounting, education, hospitality, logistics, and skilled roles.</p>
          </div>
          <div class="process-card">
            <span class="icon-circle">→</span>
            <h3>Direct apply links</h3>
            <p>Paid posts include official links, summary notes, support evidence, and application practical planning notes.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split-feature">
        <div>
          <span class="mini-eyebrow">Weekly format</span>
          <h2>Public newsletter first. Full paid list after the paywall.</h2>
          <p class="feature-lead">
            Relocate Works is a Substack-first publication. Free readers can read public newsletter editions. Paid members unlock the full weekly list, direct apply links, support evidence, salary notes when available, and practical planning notes.
          </p>
          <div class="feature-list">
            <div><strong>Public newsletter</strong><span>Public newsletter editions and destination information.</span></div>
            <div><strong>Monthly access</strong><span>$9/month for candidates who want to test the full list before committing.</span></div>
            <div><strong>Founding yearly access</strong><span>$49/year for early members preparing to apply abroad over the next 6–12 months.</span></div>
          </div>
        </div>
        <div class="pricing-preview" id="pricing">
          <span class="badge badge-success">Special founding price</span>
          <h3>$9/month</h3>
          <p>Monthly access to the full weekly sponsor job intelligence list.</p>
          <span class="pricing-highlight">Best for trying the product</span>
          <hr />
          <h3>$49/year</h3>
          <p>Founding yearly access for early members. Future pricing may increase to $15/month or $99/year.</p>
          <ul>
            <li>Full weekly sponsor-friendly job list</li>
            <li>Direct apply links</li>
            <li>Confirmed/Potential evidence notes</li>
            <li>Industry requirement and practical planning notes</li>
            <li>Archive access while subscribed</li>
          </ul>
          <a class="button" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Join founding access</a>
        </div>
      </div>
    </section>

    <section class="section section-white">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="mini-eyebrow">Industries covered</span>
            <h2>Built for more than tech candidates.</h2>
          </div>
          <p>Each weekly post can include multiple industries, so candidates from different backgrounds can find relevant relocation opportunities.</p>
        </div>
        <div class="industry-grid compact-industry-grid">
          {industries.map((industry) => (
            <a class="industry-card compact" href={`/industries/${industry.slug}`}>
              <div class="industry-icon">{industry.icon}</div>
              <h3>{industry.shortName}</h3>
              <p>{industry.description}</p>
              <strong>Read requirements →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="mini-eyebrow">Countries covered first</span>
            <h2>Launch job research markets</h2>
          </div>
          <p>These are the five original featured job-research markets. Our free country library now includes {countries.length} destinations; countries covered in each Substack roundup may vary.</p>
        </div>
        <div class="grid-3">
          {launchCountries.map((country) => (
            <a class="country-card" href={`/countries/${country.slug}`}>
              <div class="country-card-glow" aria-hidden="true"></div>
              <div class="country-top">
                <span class="flag">{country.flag}</span>
                <div>
                  <div class="country-label">Launch focus</div>
                  <h3>{country.name}</h3>
                </div>
              </div>
              <p class="country-visa">{country.primaryVisa}</p>
            </a>
          ))}

        </div>
      </div>
    </section>

    <section class="section section-white subscription-terms-section">
      <div class="container split-feature">
        <div class="content-block">
          <span class="mini-eyebrow">Subscription terms</span>
          <h2>Know exactly what you are buying.</h2>
          <p>
            Relocate Works paid access is a digital research product. You are buying member-only weekly sponsor-friendly job intelligence, not immigration advice, recruitment representation, or a guaranteed job outcome.
          </p>
          <ul class="check-list">
            <li>Included: full weekly job list, direct apply links, sponsor signals, evidence notes, salary notes when available, visa pathway notes, practical planning notes, and application guidance.</li>
            <li>Not included: guaranteed job offers, guaranteed visa sponsorship, personal visa consultation, legal advice, direct employer referrals, or personal CV review unless separately offered.</li>
            <li>Job availability can change quickly. Always verify details directly with employers and official sources before applying.</li>
            <li>Founding pricing applies while your subscription remains active. Future public pricing may increase as country coverage, job volume, and member resources expand.</li>
          </ul>
        </div>
        <div class="content-block warning-block">
          <span class="mini-eyebrow">Important disclaimer</span>
          <h2>Research only, not legal advice.</h2>
          <p>
            Relocate Works is not an immigration law firm, recruitment agency, visa consultancy, tax advisor, or relocation agent. Our classification describes published evidence and is not a guarantee of individual sponsorship.
          </p>
          <p>
            We aim to publish a useful weekly list, but the number of jobs may vary depending on market conditions, quality of available sponsor-friendly roles, country coverage, and hiring activity.
          </p>
          <a class="inline-link" href="/terms">Read full terms →</a>
        </div>
      </div>
    </section>
    <CTA />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CountryCard from '../components/CountryCard.astro';
import TopicLinks from '../components/TopicLinks.astro';
import { SITE, countries, industries, blogPosts } from '../data';

const featured = countries.slice(0, 6);
const topics = [
  { icon: '◈', eyebrow: 'Immigration', title: 'Visas & residence', description: 'Identify routes and questions to check with official immigration sources.', href: '/visas' },
  { icon: '▣', eyebrow: 'Career planning', title: 'Salary research', description: 'Put gross pay, tax and regional salary context into perspective.', href: '/salaries' },
  { icon: '⌁', eyebrow: 'Your finances', title: 'Taxes', description: 'Start researching income tax, payroll and your potential take-home pay.', href: '/taxes' },
  { icon: '⌂', eyebrow: 'Everyday life', title: 'Cost of living', description: 'Explore housing, travel and settlement costs before making a move.', href: '/cost-of-living' },
  { icon: '◇', eyebrow: 'Career planning', title: 'Job-market guides', description: 'Understand opportunities and work-rights language in your destination.', href: '/jobs' },
  { icon: '◉', eyebrow: 'Moving abroad', title: 'Relocation services', description: 'Navigate the logistics of finding housing and settling into a new place.', href: '/relocation-companies' }
];
---
<BaseLayout title="Relocate Works | Plan Your Move Abroad with Confidence" description={`Independent destination guides covering visas, work, salaries, taxes and everyday life across ${countries.length} countries. Dated international job roundups are published separately on Substack.`} canonicalPath="/">
  <Header />
  <main class="rw-main">
    <section class="rw-hero">
      <div class="container rw-hero-layout">
        <div class="rw-hero-copy">
          <span class="rw-kicker rw-kicker-light"><span class="rw-kicker-dot"></span> INDEPENDENT RELOCATION RESEARCH</span>
          <h1>Your next chapter starts with <em>a clearer picture.</em></h1>
          <p class="rw-hero-lead">Explore destinations, understand visa routes and compare the practical details of moving abroad. One calm place to start planning a life somewhere new.</p>
          <form class="rw-hero-search" method="GET" action="/countries" role="search">
            <label class="sr-only" for="hero-country-search">Search countries, cities or career sectors</label>
            <span class="rw-search-icon" aria-hidden="true">⌕</span>
            <input id="hero-country-search" name="q" type="search" placeholder="Search a country, city or career sector" autocomplete="off" />
            <button type="submit">Explore <span aria-hidden="true">→</span></button>
          </form>
          <div class="rw-hero-quicklinks">
            <span>Popular destinations</span>
            {countries.slice(0, 4).map((country) => <a href={'/countries/' + country.slug}>{country.flag} {country.name}</a>)}
          </div>
        </div>
        <div class="rw-hero-visual" aria-label="Three steps to planning an international move">
          <div class="rw-visual-orbit rw-orbit-one" aria-hidden="true"></div>
          <div class="rw-visual-orbit rw-orbit-two" aria-hidden="true"></div>
          <div class="rw-visual-star rw-star-one" aria-hidden="true">✧</div>
          <div class="rw-visual-star rw-star-two" aria-hidden="true">✦</div>
          <div class="rw-plan-card">
            <div class="rw-plan-card-top"><span class="rw-plan-symbol">↗</span><span>YOUR RELOCATION FIELD GUIDE</span><span class="rw-plan-dots" aria-hidden="true">● ● ●</span></div>
            <div class="rw-plan-card-body">
              <div class="rw-plan-card-label">FROM CURIOUS TO PREPARED</div>
              <h2>A better plan<br />for the big move.</h2>
              <div class="rw-plan-step"><span>01</span><div><strong>Choose a destination</strong><small>Explore our country guides</small></div><span aria-hidden="true">↗</span></div>
              <div class="rw-plan-step"><span>02</span><div><strong>Understand your route</strong><small>Visas, careers and financial context</small></div><span aria-hidden="true">↗</span></div>
              <div class="rw-plan-step"><span>03</span><div><strong>Prepare for arrival</strong><small>Housing, healthcare and next steps</small></div><span aria-hidden="true">↗</span></div>
            </div>
            <div class="rw-plan-card-bottom"><span>DESTINATIONS TO EXPLORE</span><span aria-hidden="true">🇦🇺 🇳🇿 🇩🇪 🇨🇦 🇸🇬</span></div>
          </div>
          <span class="rw-visual-note">Explore the possibilities.<br /><strong>Plan with the details.</strong></span>
        </div>
      </div>
      <div class="container rw-hero-foot">
        <span><strong>{countries.length}</strong> country guides</span><span aria-hidden="true" class="rw-foot-divider"></span>
        <span><strong>{industries.length.toString().padStart(2, '0')}</strong> career sectors</span><span aria-hidden="true" class="rw-foot-divider"></span>
        <span><strong>Free</strong> relocation library</span>
      </div>
    </section>

    <section class="rw-section rw-destinations-section">
      <div class="container">
        <div class="rw-section-head">
          <div><span class="rw-kicker">DESTINATIONS, MADE CLEARER</span><h2>Where could your next chapter take you?</h2></div>
          <div class="rw-head-side"><p>Start with the possibilities. Explore visa routes, salary context and the realities of day-to-day life.</p><a class="rw-text-link" href="/countries">All {countries.length} country guides <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="rw-countries-grid">
          {featured.map((country) => <CountryCard {...country} />)}
        </div>
        <div class="rw-section-footer-link"><a href="/countries">Explore every destination <span aria-hidden="true">→</span></a><span>Australia · New Zealand · United Kingdom · Germany · Canada and more</span></div>
      </div>
    </section>

    <section class="rw-section rw-section-cream">
      <div class="container">
        <div class="rw-section-head"><div><span class="rw-kicker">THE PRACTICAL DETAILS</span><h2>Good decisions begin with good questions.</h2></div><p>Explore the topics that shape a relocation decision before committing to a move.</p></div>
        <TopicLinks items={topics} />
      </div>
    </section>

    <section class="rw-section">
      <div class="container rw-editorial-split">
        <div class="rw-editorial-copy">
          <span class="rw-kicker">WHY RELOCATE WORKS EXISTS</span>
          <h2>Less guesswork.<br /><em>More perspective.</em></h2>
          <p>Moving countries is a collection of decisions, not a single application. We bring together practical research on employment, immigration and everyday life, so you can approach each step with more context.</p>
          <a class="rw-text-link" href="/about">Our approach <span aria-hidden="true">↗</span></a>
        </div>
        <div class="rw-editorial-points">
          <div><span>01 /</span><div><h3>Built around your destination</h3><p>Find related visa, salary, tax, housing and settlement topics from one country starting point.</p></div></div>
          <div><span>02 /</span><div><h3>Official links, where they matter</h3><p>Each destination guide includes government starting points so you can verify rules for your own circumstances.</p></div></div>
          <div><span>03 /</span><div><h3>Information and opportunities, separated</h3><p>Read free relocation guidance here; explore dated job research through our separate Substack publication.</p></div></div>
        </div>
      </div>
    </section>

    <section class="rw-newsletter-section">
      <div class="container rw-newsletter-inner">
        <div class="rw-newsletter-decor" aria-hidden="true">✳</div>
        <div class="rw-newsletter-copy"><span class="rw-kicker rw-kicker-light">THE WEEKLY RELOCATION LETTER</span><h2>Research the move.<br /><em>Discover the opportunities.</em></h2><p>Weekly international job research and original employer application links are published separately on Substack. This website is the free research library.</p><div class="rw-newsletter-actions"><a class="rw-btn rw-btn-light" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Read the newsletter <span aria-hidden="true">↗</span></a><a class="rw-newsletter-secondary" href="/jobs/free-preview">How it works <span aria-hidden="true">→</span></a></div></div>
        <div class="rw-newsletter-aside"><span>YOUR RESEARCH COMPANION</span><div>Better informed.<br />Better prepared.</div><span aria-hidden="true">↗</span></div>
      </div>
    </section>

    <section class="rw-section rw-industry-section">
      <div class="container">
        <div class="rw-section-head"><div><span class="rw-kicker">YOUR CAREER, YOUR PATH</span><h2>Relocation looks different for everyone.</h2></div><div class="rw-head-side"><p>Understand career-specific requirements, documents and international hiring context.</p><a class="rw-text-link" href="/industries">View all industries <span aria-hidden="true">↗</span></a></div></div>
        <div class="rw-industry-grid">
          {industries.map((industry) => <a class="rw-industry-card" href={'/industries/' + industry.slug}><span class="rw-industry-icon" aria-hidden="true">{industry.icon}</span><div><h3>{industry.shortName}</h3><p>{industry.description}</p></div><span aria-hidden="true" class="rw-industry-arrow">↗</span></a>)}
        </div>
      </div>
    </section>

    <section class="rw-section rw-section-cream rw-articles-section">
      <div class="container">
        <div class="rw-section-head"><div><span class="rw-kicker">FROM THE LIBRARY</span><h2>Start with a little more insight.</h2></div><a class="rw-text-link" href="/blog">Explore all articles <span aria-hidden="true">↗</span></a></div>
        <div class="rw-article-grid">
          {blogPosts.slice(0, 3).map((post) => <a class="rw-article-card" href={'/blog/' + post.slug}><span class="rw-article-label">{post.category}</span><h3>{post.title}</h3><p>{post.description}</p><span class="rw-article-more">Read article <span aria-hidden="true">↗</span></span></a>)}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

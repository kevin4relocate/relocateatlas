---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { blogPosts } from '../../data';
---
<BaseLayout
  title="Relocate Works Blog — Visa Sponsor Jobs and Relocation Guides"
  description="Read practical guides about visa sponsor jobs, relocation-friendly employers, global career moves, and international job applications."
  canonicalPath="/blog"
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <span class="eyebrow">Relocation Guides</span>
        <h1>Visa sponsor jobs and relocation articles.</h1>
        <p class="lead">
          Practical guides for international candidates who want to find better global job opportunities and understand relocation signals.
        </p>
      </div>
    </section>
    <section class="section">
      <div class="container grid-3">
        {blogPosts.map((post) => (
          <a class="article-card" href={`/blog/${post.slug}`}>
            <div class="article-meta">{post.category} · {post.date}</div>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
          </a>
        ))}
      </div>
    </section>
    <CTA />
  </main>
  <Footer />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ReferralDisclosure from './ReferralDisclosure.astro';
import AIOpportunityCard from './AIOpportunityCard.astro';
import { aiCategories, activeOpportunities, referralUrl, type Category } from '../data/aiOpportunities';
import '../ai-opportunities.css';
import { stanfordYouthStudy as study } from '../data/aiStudies';
interface Props { category?: Category }
const { category } = Astro.props;
const path = '/remote-ai-jobs' + (category ? '/' + category.slug : '');
const title = category ? `${category.title} AI Opportunities | Relocate Works` : 'Remote AI Opportunities for Global Professionals | Relocate Works';
const description = category ? category.summary : 'Explore AI training, evaluation and specialist career paths. Browse professional categories and continue to Mercor through clearly disclosed referral links.';
const items = activeOpportunities.filter(item => !category || item.categorySlug === category.slug);
const breadcrumbs = [{ name: 'Home', item: 'https://relocateworks.com/' }, { name: 'AI Opportunities', item: 'https://relocateworks.com/remote-ai-jobs' }, ...(category ? [{ name: category.title, item: 'https://relocateworks.com' + path }] : [])];
---
<BaseLayout title={title} description={description} canonicalPath={path} structuredData={{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })) }}>
  <Header />
  <main id="main-content" class="ai-main">
    <section class="ai-hero">
      <div class="container">
        <nav class="ai-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true"> / </span>{category ? <><a href="/remote-ai-jobs">AI Opportunities</a><span aria-hidden="true"> / </span><span aria-current="page">{category.title}</span></> : <span aria-current="page">AI Opportunities</span>}</nav>
        <div class="ai-hero-grid"><div>
          <span class="ai-label">GLOBAL EXPERTISE · REMOTE POSSIBILITIES</span>
          <h1>{category ? <>Bring your <em>{category.title.toLowerCase()}</em> expertise to AI.</> : <>Explore remote AI opportunities for <em>global professionals.</em></>}</h1>
          <p class="ai-lead">{category ? category.summary : 'Discover AI training, model evaluation and specialist career paths. Find a starting point for your expertise and explore opportunities directly on the hiring platform.'}</p>
          <div class="ai-actions"><a class="rw-btn rw-btn-primary" href={category ? referralUrl(category.referralKey) : '#categories'} {...(category ? { target: '_blank', rel: 'sponsored noopener noreferrer' } : {})}>{category ? 'Explore on Mercor ↗' : 'Find your field ↓'}</a><a href="#how-it-works">How it works</a></div>
          {category && <p class="ai-small">Referral link to {category.linkScope}. This is a category discovery destination, not a specific vacancy.</p>}
        </div><aside class="ai-hero-panel"><span class="ai-label">BEFORE YOU APPLY</span><h2>Your experience is the starting point.</h2><ul><li>Check location and work eligibility for each role.</li><li>Read the exact pay, scope and contract terms.</li><li>Apply and complete assessments on the official platform.</li></ul><p>Remote work does not automatically include visa sponsorship or immigration benefits.</p></aside></div>
      </div>
    </section>
    <div class="container ai-content">
      <ReferralDisclosure />
      {category ? <section class="ai-section"><span class="ai-label">PREPARE WITH PURPOSE</span><h2>Before exploring {category.title.toLowerCase()} opportunities</h2><ul>{category.preparation.map(text => <li>{text}</li>)}</ul><p>These are preparation suggestions, not verified hiring requirements. The official listing determines qualifications, experience and employment classification.</p></section> : <section id="categories" class="ai-section">
        <div class="ai-section-heading"><div><span class="ai-label">FIND YOUR FIELD</span><h2>Start with what you know.</h2></div><p>Browse professional pathways. Categories do not indicate current openings.</p></div>
        <div class="ai-search" data-ai-search hidden><label for="ai-category-search">Search fields</label><input id="ai-category-search" type="search" placeholder="Try software, finance or language" /><p data-ai-count role="status" aria-live="polite"></p></div>
        <div class="ai-category-grid">{aiCategories.map((field, index) => <article class="ai-card" data-ai-category data-search={`${field.title} ${field.summary}`.toLowerCase()}><span class="ai-card-number">{String(index + 1).padStart(2, '0')}</span><h3><a href={'/remote-ai-jobs/' + field.slug}>{field.title} <span aria-hidden="true">↗</span></a></h3><p>{field.summary}</p><a class="ai-text-link" href={'/remote-ai-jobs/' + field.slug}>Explore this field →</a></article>)}</div>
        <p data-ai-empty hidden>No matching fields. Try a broader term or clear your search.</p>
      </section>}
      {(!category || category.slug === 'research') && <section class="ai-section" aria-labelledby="research-study-title"><span class="ai-label">RESEARCH PARTICIPATION · US ONLY</span><h2 id="research-study-title">A study for parents and children</h2><article class="ai-card"><h3><a href={study.path}>{study.title}</a></h3><p>{study.description}</p><p><strong>$110 total on completion · Approximately 8 weeks</strong></p><p>Requires a child’s own smartphone with an active SIM. Listing text supplied by the site owner; confirm current availability, cohort year and payment terms on Mercor.</p><a class="ai-text-link" href={study.path}>Read eligibility and study details →</a></article></section>}
      <section class="ai-section" aria-labelledby="listings-title"><span class="ai-label">INDIVIDUAL OPPORTUNITIES</span><h2 id="listings-title">Check the role before you apply.</h2>{items.length ? <div class="ai-category-grid">{items.map(item => <AIOpportunityCard opportunity={item} />)}</div> : <div class="ai-empty"><h3>No individually verified listings published here yet.</h3><p>You can explore {category?.linkScope ?? 'general opportunities'} on Mercor. Availability, compensation, country eligibility and requirements must be checked on the official destination.</p><a class="rw-btn rw-btn-primary" href={referralUrl(category?.referralKey ?? 'general')} target="_blank" rel="sponsored noopener noreferrer">Explore on Mercor ↗</a><p class="ai-small">Referral link. No hiring or earnings guarantee.</p></div>}</section>
      <section class="ai-section" aria-labelledby="ai-portfolio-title"><span class="ai-label">APPLICATION PREPARATION</span><h2 id="ai-portfolio-title">Build an evidence pack before applying.</h2><p>Before clicking a referral, collect brief examples that demonstrate the skills relevant to your field.</p><ul><li>Save two or three concrete examples of your professional judgment and explain your reasoning.</li><li>Be ready to describe your qualifications, equipment and country of residence accurately.</li><li>Check confidentiality obligations before sharing work samples or client information.</li><li>Confirm assessment format, payment conditions and contract classification on the official platform.</li></ul><p class="ai-small">Preparation guidance only. No current vacancy or acceptance is implied.</p></section>
      <section id="how-it-works" class="ai-section"><span class="ai-label">FROM DISCOVERY TO APPLICATION</span><h2>A clear path to the official platform.</h2><ol class="ai-steps"><li><h3>Explore your field</h3><p>Identify work relevant to your background. AI evaluation may involve reviewing outputs, applying rubrics or using specialist knowledge.</p></li><li><h3>Check the details</h3><p>Confirm location, equipment, availability, qualifications, pay and contract classification in the official listing. Compensation: not disclosed here unless verified for an individual role.</p></li><li><h3>Apply directly</h3><p>The platform handles assessment, selection, contracts and payments. An outbound click is not an accepted application or successful referral.</p></li></ol><a href={referralUrl('generalApplication')} target="_blank" rel="sponsored noopener noreferrer">Continue to Mercor through our general referral link ↗</a></section>
      <section class="ai-section ai-faq"><span class="ai-label">GOOD QUESTIONS</span><h2>Know what to expect.</h2>
        <details><summary>Can I apply from any country?</summary><p>Eligibility varies by role and platform. Check official eligibility requirements; global discovery does not mean worldwide eligibility for every opportunity.</p></details>
        <details><summary>How much can I earn?</summary><p>There is no general earnings promise. Check each listing’s currency, pay unit, workload and contract terms. If no verified compensation is available, we show “Not disclosed.”</p></details>
        <details><summary>Does a referral guarantee work?</summary><p>No. The platform makes its own screening and hiring decisions. Referral reward conditions and candidate attribution are determined by the platform.</p></details>
        <details><summary>Do I send my resume to Relocate Works?</summary><p>No. Apply on the official platform. This section has no candidate registration or resume upload. The destination’s privacy policy applies when you leave this site.</p></details>
        <details><summary>Is this the same as the relocation newsletter?</summary><p>No. These remote AI resources are separate from our <a href="/jobs/free-preview">weekly relocation job newsletter</a> and <a href="/jobs">country job-market guides</a>. Remote work does not imply visa support.</p></details>
      </section>
      {category && <section class="ai-section"><h2>Explore another field</h2><div class="ai-related">{aiCategories.filter(field => field.slug !== category.slug).map(field => <a href={'/remote-ai-jobs/' + field.slug}>{field.title}</a>)}</div></section>}
    </div>
  </main>
  <Footer />
</BaseLayout>
<script>
  const search = document.querySelector<HTMLElement>('[data-ai-search]');
  const input = document.querySelector<HTMLInputElement>('#ai-category-search');
  if (search && input) {
    search.hidden = false;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-ai-category]'));
    const update = () => {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      cards.forEach(card => { card.hidden = !card.dataset.search?.includes(query); if (!card.hidden) count++; });
      const status = document.querySelector('[data-ai-count]');
      if (status) status.textContent = `${count} of ${cards.length} fields`;
      const empty = document.querySelector<HTMLElement>('[data-ai-empty]');
      if (empty) empty.hidden = count !== 0;
    };
    input.addEventListener('input', update); update();
  }
</script>

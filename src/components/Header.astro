---
import { SITE, countries, industries } from '../data';

const launchCountries = countries.filter((country) => country.priority === 'Launch');
const nextCountries = countries.filter((country) => country.priority === 'Next');

const resourceLinks = [
  {
    href: '/visas',
    label: 'Visa Guides',
    description: 'Work visas and sponsorship pathways'
  },
  {
    href: '/jobs',
    label: 'Job Guides',
    description: 'Country-specific job-market information'
  },
  {
    href: '/salaries',
    label: 'Salary Guides',
    description: 'Salary signals and pay context'
  },
  {
    href: '/taxes',
    label: 'Tax Guides',
    description: 'Income tax, tax year, payroll basics'
  },
  {
    href: '/cost-of-living',
    label: 'Cost of Living',
    description: 'Rent, groceries, transport, insurance'
  },
  {
    href: '/relocation-companies',
    label: 'Relocation Companies',
    description: 'Moving, settling-in, and relocation support'
  }
];

const productLinks = [
  {
    href: '/visa-sponsor-jobs',
    label: 'Visa Sponsor Jobs',
    description: 'Weekly sponsor-friendly job intelligence'
  },
  {
    href: '/jobs/free-preview',
    label: 'Weekly Newsletter',
    description: 'Learn how our Substack job roundup works'
  },
  {
    href: '/pricing',
    label: 'Pricing',
    description: '$9/month or $49/year founding access'
  }
];
---
<header class="site-header">
  <div class="container header-inner header-inner-clean">
    <a class="logo" href="/" aria-label="Relocate Works home">
      <img
        class="logo-mark"
        src="/favicon.svg"
        width="40"
        height="40"
        alt=""
        aria-hidden="true"
      />
      <span>Relocate Works</span>
    </a>

    <nav class="nav nav-wide nav-clean" aria-label="Main navigation">
      <div class="nav-dropdown">
        <a
          href="/countries"
          class="nav-dropdown-link"
          aria-haspopup="true"
        >
          Countries
        </a>

        <div class="nav-dropdown-panel country-dropdown-panel" aria-label="Country shortcuts">
          <div class="nav-dropdown-grid country-dropdown-grid">
            <div>
              <strong>Launch countries</strong>
              {launchCountries.map((country) => (
                <a href={`/countries/${country.slug}`}>
                  <span aria-hidden="true">{country.flag}</span>
                  {country.name}
                </a>
              ))}
            </div>

            <div>
              <strong>More countries</strong>
              {nextCountries.map((country) => (
                <a href={`/countries/${country.slug}`}>
                  <span aria-hidden="true">{country.flag}</span>
                  {country.name}
                </a>
              ))}
            </div>
          </div>

          <a class="nav-dropdown-footer" href="/countries">Compare all countries →</a>
        </div>
      </div>

      <a href="/visa-sponsor-jobs">Visa Sponsor Jobs</a>

      <div class="nav-dropdown nav-dropdown-industries">
        <a
          href="/industries"
          class="nav-dropdown-link"
          aria-haspopup="true"
        >
          Industries
        </a>

        <div class="nav-dropdown-panel industries-dropdown-panel" aria-label="Industry shortcuts">
          <div class="industries-dropdown-list">
            {industries.map((industry) => (
              <a href={`/industries/${industry.slug}`}>
                <span class="dropdown-icon" aria-hidden="true">{industry.icon}</span>
                <span>
                  <strong>{industry.shortName}</strong>
                  <small>{industry.commonRoles.slice(0, 3).join(', ')}</small>
                </span>
              </a>
            ))}
          </div>

          <a class="nav-dropdown-footer" href="/industries">Explore all industries →</a>
        </div>
      </div>

      <div class="nav-dropdown nav-dropdown-resources">
        <a
          href="/visas"
          class="nav-dropdown-link"
          aria-haspopup="true"
        >
          Guides
        </a>

        <div class="nav-dropdown-panel resources-dropdown-panel" aria-label="Relocation guides">
          <div class="resources-dropdown-list">
            {resourceLinks.map((item) => (
              <a href={item.href}>
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </a>
            ))}
          </div>

          <a class="nav-dropdown-footer" href="/blog">Read latest guides →</a>
        </div>
      </div>

      <div class="nav-dropdown nav-dropdown-resources">
        <a
          href="/pricing"
          class="nav-dropdown-link"
          aria-haspopup="true"
        >
          Pricing
        </a>

        <div class="nav-dropdown-panel resources-dropdown-panel" aria-label="Relocate Works subscription">
          <div class="resources-dropdown-list">
            {productLinks.map((item) => (
              <a href={item.href}>
                <strong>{item.label}</strong>
                <small>{item.description}</small>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/blog">Blog</a>
    </nav>

    <div class="header-actions header-actions-clean">
      <a
        class="button button-small"
        href={SITE.substackUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Subscribe
      </a>

      <button
        class="mobile-menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
        aria-label="Open menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  
</header>

<div id="mobile-menu" class="mobile-menu" data-mobile-menu>
    <div class="container mobile-menu-inner mobile-menu-clean">
      <div class="mobile-menu-section">
        <strong>Main</strong>
        <a href="/countries">Countries</a>
        <a href="/visa-sponsor-jobs">Visa Sponsor Jobs</a>
        <a href="/industries">Industries</a>
        <a href="/pricing">Pricing</a>
        <a href="/blog">Blog</a>
      </div>

      <div class="mobile-menu-section">
        <strong>Guides</strong>
        <div class="mobile-country-grid mobile-resource-grid">
          {resourceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      <div class="mobile-menu-section">
        <strong>Countries</strong>
        <div class="mobile-country-grid">
          {countries.map((country) => (
            <a href={`/countries/${country.slug}`}>
              {country.flag} {country.name}
            </a>
          ))}
        </div>
      </div>

      <div class="mobile-menu-section">
        <strong>Industries</strong>
        <div class="mobile-country-grid mobile-industry-grid">
          {industries.map((industry) => (
            <a href={`/industries/${industry.slug}`}>
              {industry.icon} {industry.shortName}
            </a>
          ))}
        </div>
      </div>

      <div class="mobile-menu-section">
        <strong>Subscription</strong>
        <div class="mobile-country-grid mobile-resource-grid">
          {productLinks.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>

      <div class="mobile-menu-actions">
        <a
          class="button"
          href={SITE.substackUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Subscribe on Substack
        </a>
      </div>
    </div>
  </div>
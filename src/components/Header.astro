---
import { SITE, countries } from '../data';
const featured = countries.filter((country) => country.priority === 'Launch');
const more = countries.filter((country) => country.priority !== 'Launch');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isWeeklyLanding = path === '/jobs/free-preview';
const navItems = [
  { href: '/remote-ai-jobs', label: 'AI Opportunities', active: path.startsWith('/remote-ai-jobs') },
  { href: '/guides', label: 'Relocation guides', active: path === '/guides' || ['/visas','/taxes','/salaries','/cost-of-living','/relocation-companies','/jobs'].some((p) => path === p || path.startsWith(p + '/')) && path !== '/jobs/free-preview' },
  { href: '/industries', label: 'Industries', active: path.startsWith('/industries') },
  { href: '/jobs/free-preview', label: 'Weekly jobs', active: path === '/jobs/free-preview' || path === '/visa-sponsor-jobs' }
];
---
<header class:list={['site-header', 'rw-header', { 'rw-header-weekly': isWeeklyLanding }]}>
  <div class="container rw-header-inner">
    <a class="rw-brand" href="/" aria-label={`${SITE.name} home`}>
      <img src="/brand-mark-blue.svg" width="42" height="42" alt="" aria-hidden="true" />
      <span class="rw-brand-wordmark rw-brand-expanded"><span>Relocate <strong>Works</strong></span><span class="rw-brand-secondary">&amp; Remote AI Works</span></span>
    </a>
    <nav class="rw-desktop-nav" aria-label="Main navigation">
      <details class="rw-nav-details" data-rw-nav-details>
        <summary class:list={['rw-nav-link', { 'rw-current': path === '/countries' || path.startsWith('/countries/') }]}>
          Countries <svg class="rw-chevron" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6.25 8 10l4-3.75" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </summary>
        <div class="rw-mega-menu">
          <div class="rw-menu-head"><strong>Explore destinations</strong><span>Start with the country that matters to you.</span></div>
          <div class="rw-menu-cols">
            <div><span class="rw-menu-label">FEATURED DESTINATIONS</span>
              {featured.map((country) => <a href={'/countries/' + country.slug}><span aria-hidden="true">{country.flag}</span>{country.name}</a>)}
            </div>
            <div><span class="rw-menu-label">MORE DESTINATIONS</span>
              {more.map((country) => <a href={'/countries/' + country.slug}><span aria-hidden="true">{country.flag}</span>{country.name}</a>)}
            </div>
          </div>
          <a class="rw-menu-footer" href="/countries">Browse all country guides <span aria-hidden="true">→</span></a>
        </div>
      </details>
      {navItems.map((item) => <a class:list={['rw-nav-link', { 'rw-current': item.active }]} href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="rw-header-actions">
      <a class="rw-header-cta" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer" aria-label={isWeeklyLanding ? "Subscribe to Relocate Works Weekly Jobs on Substack" : "Read the Relocate Works newsletter on Substack"}>{isWeeklyLanding ? "Subscribe" : "Read the newsletter"} <span aria-hidden="true">↗</span></a>
      <button class="mobile-menu-button rw-menu-toggle" type="button" data-mobile-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu rw-mobile-menu" data-mobile-menu>
  <div class="container rw-mobile-inner">
    <div class="rw-mobile-top">
      <span>EXPLORE RELOCATE WORKS</span>
      <button type="button" class="rw-mobile-close" data-rw-menu-close aria-label="Close menu">✕</button>
    </div>
    <nav aria-label="Mobile navigation">
      <a class="rw-mobile-primary" href="/countries">All countries <span aria-hidden="true">↗</span></a>
      <a class="rw-mobile-primary" href="/guides">Relocation guides <span aria-hidden="true">↗</span></a>
      <a class="rw-mobile-primary" href="/remote-ai-jobs">AI Opportunities <span aria-hidden="true">↗</span></a>
      <a class="rw-mobile-primary" href="/industries">Industries <span aria-hidden="true">↗</span></a>
      <a class="rw-mobile-primary" href="/jobs/free-preview">Weekly jobs <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="rw-mobile-group">
      <strong>COUNTRIES</strong>
      <div class="rw-mobile-country-grid">
        {countries.map((country) => <a href={'/countries/' + country.slug}><span aria-hidden="true">{country.flag}</span>{country.name}</a>)}
      </div>
    </div>
    <div class="rw-mobile-group">
      <strong>QUICK LINKS</strong>
      <div class="rw-mobile-country-grid">
        <a href="/visas">Visas</a><a href="/salaries">Salaries</a><a href="/taxes">Taxes</a><a href="/cost-of-living">Living costs</a>
      </div>
    </div>
    <a class="rw-btn rw-btn-primary rw-mobile-substack" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">{isWeeklyLanding ? "Subscribe to Weekly Jobs" : "Read weekly jobs on Substack"} <span aria-hidden="true">↗</span></a>
  </div>
</div>

<script>
  const initCountryMenu = () => {
    const dropdown = document.querySelector<HTMLDetailsElement>('[data-rw-nav-details]');
    if (!dropdown || dropdown.dataset.ready === 'true') return;
    dropdown.dataset.ready = 'true';
    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target as Node)) dropdown.open = false;
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        dropdown.open = false;
        dropdown.querySelector('summary')?.focus();
      }
    });
  };
  initCountryMenu();
  document.addEventListener('astro:page-load', initCountryMenu);
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTA from './CTA.astro';
import CountryResourceNav from './CountryResourceNav.astro';
import { SITE, resourceSections, blogPosts } from '../data';

const { country, sectionSlug } = Astro.props;
const section = resourceSections.find((item) => item.slug === sectionSlug);
if (!section) throw new Error(`Unknown resource section: ${sectionSlug}`);

const softDisclaimer = 'Relocate Works helps you research sponsor-friendly opportunities faster. Final eligibility, visa support, and hiring decisions depend on each employer and official immigration rules.';

const profiles = {
  australia: {
    currency: 'AUD',
    monthly: [['Sydney', 'AUD 3,600–5,600', 'Highest rent pressure, strongest finance and tech density.'], ['Melbourne', 'AUD 3,100–4,900', 'Strong job market with slightly different cost profile.'], ['Brisbane', 'AUD 2,700–4,300', 'Often better lifestyle-cost balance for skilled workers.'], ['Perth', 'AUD 2,600–4,200', 'Important for engineering, resources, and professional roles.']],

  },
  'new-zealand': {
    currency: 'NZD',
    monthly: [
      ['Auckland', 'NZD 3,200–5,000', 'Largest market, high housing pressure.'],
      ['Wellington', 'NZD 2,900–4,600', 'Government, tech, and professional services hub.'],
      ['Christchurch', 'NZD 2,500–4,000', 'Often more manageable cost base.'],
      ['Hamilton', 'NZD 2,300–3,800', 'Useful for some healthcare, education, and regional roles.']

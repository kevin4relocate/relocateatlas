  },
  ireland: {
    currency: 'EUR',
    monthly: [['Dublin', 'EUR 2,400–4,200', 'Strong tech and finance market, high rent.'], ['Cork', 'EUR 1,900–3,300', 'Good tech, pharma, and professional market.'], ['Galway', 'EUR 1,800–3,100', 'Useful for medtech and professional roles.'], ['Limerick', 'EUR 1,600–2,900', 'Potentially better cost base.']],
    setup: 'EUR 4,500–10,000+', rent: 'EUR 1,000–2,400+ / month', groceries: 'EUR 300–600 / month', transport: 'EUR 70–180 / month', utilities: 'EUR 170–350 / month',
    salaries: [['Software Engineer', 'EUR 60k–105k'], ['QA / Test Engineer', 'EUR 45k–75k'], ['Cloud / DevOps Engineer', 'EUR 70k–120k'], ['Cybersecurity Engineer', 'EUR 65k–115k'], ['Accountant / Auditor', 'EUR 45k–80k'], ['Healthcare Professional', 'EUR 40k–80k']],
    tax: ['Tax planning should consider income tax, social insurance, and universal social charge-style deductions.', 'Dublin salaries should be compared carefully against housing availability.', 'Benefits, pension, and relocation support can meaningfully change the offer value.'],
    visas: [['Critical Skills Employment Permit', 'High-skill eligible roles.', 'Employer offer is central.', 'Useful for technology, engineering, healthcare, and specialist roles.'], ['General Employment Permit', 'Roles not covered by critical skills where eligible.', 'Employer and labor-market context matter.', 'Check occupation lists, salary, and employer obligations.'], ['Intra-company transfer routes', 'Moving within a multinational employer.', 'Employer structure matters.', 'Useful for candidates already inside global companies.']],
    relocationCosts: [['Shipment / moving help', 'EUR 1,500–7,000+'], ['Temporary housing', 'EUR 2,000–6,000+'], ['Destination services', 'EUR 500–2,500+'], ['Full corporate package', 'Varies by employer']]
  },
  netherlands: {
    currency: 'EUR',
    monthly: [['Amsterdam', 'EUR 2,400–4,100', 'High demand, strong international companies, high rent.'], ['Eindhoven', 'EUR 1,900–3,300', 'Strong engineering and technology cluster.'], ['Rotterdam', 'EUR 1,900–3,300', 'Logistics, engineering, and professional services.'], ['Utrecht', 'EUR 2,000–3,500', 'Central location with high professional demand.']],
    setup: 'EUR 4,500–10,000+', rent: 'EUR 1,000–2,300+ / month', groceries: 'EUR 300–600 / month', transport: 'EUR 80–180 / month', utilities: 'EUR 180–350 / month',
    salaries: [['Software Engineer', 'EUR 60k–100k'], ['QA / Test Engineer', 'EUR 45k–78k'], ['Cloud / DevOps Engineer', 'EUR 70k–115k'], ['Data Engineer', 'EUR 60k–105k'], ['Mechanical Engineer', 'EUR 55k–90k'], ['Finance / Risk Analyst', 'EUR 55k–95k']],
    tax: ['Take-home pay depends on income level, social contributions, pension, and tax status.', 'Some international workers may research special tax rulings where applicable, but eligibility is specific.', 'Housing availability can be a bigger constraint than salary in some cities.'],
    visas: [['Highly Skilled Migrant route', 'Skilled professionals hired by recognized sponsors.', 'Recognized sponsor status is central.', 'Check employer sponsor status, salary threshold, and contract details.'], ['EU Blue Card-related routes', 'Higher-paid qualified professionals where applicable.', 'Employer contract and salary matter.', 'Useful for some senior and specialist roles.'], ['Intra-company transfer routes', 'Internal movement within multinational groups.', 'Employer structure matters.', 'Useful for candidates already employed by global companies.']],
    relocationCosts: [['Shipment / moving help', 'EUR 1,500–7,000+'], ['Temporary housing', 'EUR 2,000–6,000+'], ['Destination services', 'EUR 600–2,700+'], ['Full corporate package', 'Varies by employer']]
  },
  denmark: {
    currency: 'DKK',
    monthly: [['Copenhagen', 'DKK 19,000–32,000', 'Largest market, highest rent pressure.'], ['Aarhus', 'DKK 15,000–25,000', 'Strong secondary city for education, tech, and professional roles.'], ['Odense', 'DKK 13,000–22,000', 'More manageable cost base.'], ['Aalborg', 'DKK 12,000–21,000', 'Potentially lower housing pressure.']],
    setup: 'DKK 45,000–90,000+', rent: 'DKK 8,000–18,000+ / month', groceries: 'DKK 2,500–4,500 / month', transport: 'DKK 500–1,100 / month', utilities: 'DKK 1,000–2,400 / month',
    salaries: [['Software Engineer', 'DKK 550k–850k'], ['QA / Test Engineer', 'DKK 430k–680k'], ['Cloud / DevOps Engineer', 'DKK 600k–950k'], ['Mechanical Engineer', 'DKK 500k–800k'], ['Data Engineer', 'DKK 550k–900k'], ['Healthcare Specialist', 'DKK 420k–750k']],
    tax: ['Tax and municipal rules can materially affect take-home salary.', 'Gross salary should be evaluated with expected deductions, pension, rent, and relocation support.', 'High wages may still require careful budgeting in Copenhagen.'],
    visas: [['Positive List route', 'Occupations facing shortage where applicable.', 'Employer job offer is important.', 'Check whether your occupation appears and requirements are current.'], ['Pay Limit Scheme', 'Higher-salary roles where applicable.', 'Employer contract and salary are central.', 'Useful for experienced professionals with strong offers.'], ['Fast-track / employer schemes where applicable', 'Employers approved for faster handling.', 'Employer status matters.', 'Check employer and role details.']],
    relocationCosts: [['Shipment / moving help', 'DKK 12,000–60,000+'], ['Temporary housing', 'DKK 18,000–55,000+'], ['Destination services', 'DKK 4,000–20,000+'], ['Full corporate package', 'Varies widely']]
  },
  japan: {
    currency: 'JPY',
    monthly: [['Tokyo', 'JPY 230k–420k', 'Largest market, highest housing and commute complexity.'], ['Osaka', 'JPY 180k–330k', 'Strong business region with lower cost than Tokyo.'], ['Yokohama', 'JPY 200k–360k', 'Close to Tokyo market with varied costs.'], ['Fukuoka', 'JPY 160k–300k', 'Lower cost base and growing tech/startup interest.']],
    setup: 'JPY 600k–1.5m+', rent: 'JPY 80k–220k+ / month', groceries: 'JPY 35k–80k / month', transport: 'JPY 10k–30k / month', utilities: 'JPY 15k–35k / month',
    salaries: [['Software Engineer', 'JPY 6m–12m'], ['QA / Test Engineer', 'JPY 4.5m–8m'], ['Cloud / DevOps Engineer', 'JPY 7m–13m'], ['Data Engineer', 'JPY 6m–11m'], ['Product Manager', 'JPY 8m–15m'], ['Bilingual Business Role', 'JPY 5m–10m']],
    tax: ['Take-home pay depends on income tax, residence tax, social insurance, and employer benefits.', 'Initial move-in costs can be high because deposits, key money, agent fees, and guarantor costs may apply.', 'Language ability can influence both job range and daily settlement cost.'],
    visas: [['Engineer / Specialist in Humanities / International Services', 'Professional roles in tech, business, language, and specialist work.', 'Employer sponsorship is central.', 'Degree/experience and role match matter.'], ['Highly Skilled Professional route', 'High-scoring candidates with strong education, salary, and experience.', 'Employer offer usually matters.', 'Useful for senior profiles.'], ['Intra-company transfer', 'Moving within a multinational employer.', 'Company relationship matters.', 'Useful for internal transfers.']],
    relocationCosts: [['Shipment / moving help', 'JPY 200k–900k+'], ['Temporary housing', 'JPY 250k–800k+'], ['Destination services', 'JPY 80k–300k+'], ['Full corporate package', 'Varies by employer']]
  }
};

const profile = profiles[country.slug] ?? profiles.canada;
const paragraphs = country[section.field];
const listItems = country[section.items] || [];
const canonicalPath = `/${section.slug}/${country.slug}`;
const relatedPosts = blogPosts.slice(0, 3);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: section.title, item: new URL(`/${section.slug}`, SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: `${section.title} in ${country.name}`, item: new URL(canonicalPath, SITE.url).toString() }
  ]
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${section.title} in ${country.name}`,
  description: `${section.description} Planning ranges, checklists, country notes, and relocation context for ${country.name}.`,
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, logo: new URL('/favicon.svg', SITE.url).toString() },
  mainEntityOfPage: new URL(canonicalPath, SITE.url).toString()
};

function renderHeroLead() {
  const map = {
    visas: `Compare ${country.name} work authorization routes, employer sponsor signals, red flags, and questions to ask before applying.`,
    taxes: `Understand ${country.name} tax-planning basics, take-home pay factors, payroll deductions, and newcomer money questions.`,
    salaries: `Compare ${country.name} salary ranges by role, city context, and how gross pay can change after tax and rent.`,
    'cost-of-living': `Plan ${country.name} rent, groceries, transport, utilities, and first-month setup costs using practical planning ranges.`,
    'relocation-companies': `Compare relocation services in ${country.name}, what employers may cover, estimated support costs, and questions to ask.`,
    jobs: `Review ${country.name} sponsor-friendly job market signals, high-demand sectors, role types, and application risks.`
  };
  return map[section.slug] || section.description;
}
---
<BaseLayout
  title={`${section.title} in ${country.name} | Relocate Works`}
  description={`${renderHeroLead()} Relocate Works provides planning ranges and research context for international candidates.`}
  canonicalPath={canonicalPath}
  structuredData={[breadcrumbJsonLd, articleJsonLd]}
>
  <Header />
  <main>
    <section class="page-hero page-hero-gradient compact-hero resource-country-hero">
      <div class="container narrow">
        <span class="eyebrow">{country.flag} {country.name} · {section.title}</span>
        <h1>{section.title} in {country.name}</h1>
        <p class="lead">{renderHeroLead()}</p>
      </div>
    </section>

    <section class="section section-white resource-deep-section">
      <div class="container guide-layout single-guide">
        <CountryResourceNav country={country} active={section.slug} />
        <article class="guide-content">
          <section class="content-block compact-content-block">
            <span class="mini-eyebrow">{country.name} guide</span>
            <h2>{section.title} overview</h2>
            {Array.isArray(paragraphs) ? paragraphs.map((paragraph) => <p>{paragraph}</p>) : <p>{paragraphs}</p>}
            <div class="info-grid two">
              <div class="info-tile"><strong>Primary work pathway</strong><span>{country.primaryVisa}</span></div>
              <div class="info-tile"><strong>Key cities</strong><span>{country.keyCities.join(', ')}</span></div>
              <div class="info-tile"><strong>Popular roles</strong><span>{country.popularRoles.join(', ')}</span></div>
              <div class="info-tile"><strong>Currency</strong><span>{country.currency}</span></div>
            </div>
          </section>

          {section.slug === 'cost-of-living' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Planning ranges</span>
                <h2>Estimated monthly budget ranges</h2>
                <p>Use these as rough planning ranges for a single person. Actual expenses vary by neighborhood, housing type, family size, lifestyle, and whether your employer provides relocation support.</p>
                <div class="content-table-wrap">
                  <table class="content-table">
                    <thead><tr><th>City</th><th>Monthly planning range</th><th>Planning note</th></tr></thead>
                    <tbody>{profile.monthly.map((row) => <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
                  </table>
                </div>
                <div class="resource-range-grid">
                  <div class="range-card"><span>Rent</span><strong>{profile.rent}</strong></div>
                  <div class="range-card"><span>Groceries</span><strong>{profile.groceries}</strong></div>
                  <div class="range-card"><span>Transport</span><strong>{profile.transport}</strong></div>
                  <div class="range-card"><span>Utilities</span><strong>{profile.utilities}</strong></div>
                  <div class="range-card highlight"><span>First-month buffer</span><strong>{profile.setup}</strong></div>
                </div>
              </section>
              <section class="content-block compact-content-block insight-box">
                <span class="mini-eyebrow">Relocate Works insight</span>
                <h2>How to judge a {country.name} offer</h2>
                <p>A higher salary in the most expensive city is not always better than a slightly lower salary in a more affordable city. Compare gross salary, estimated take-home pay, rent, commute, healthcare or insurance, and whether the employer covers flights, temporary housing, or settlement support.</p>
                <ul class="check-list"><li>Calculate first 60–90 days of cash needs before accepting an offer.</li><li>Check whether the role requires a car or has realistic public transport options.</li><li>Ask whether relocation support is paid upfront, reimbursed later, or not included.</li></ul>
              </section>
            </>
          )}

          {section.slug === 'salaries' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Role ranges</span>
                <h2>Common salary ranges to research</h2>
                <p>These planning ranges help candidates compare offers before deeper research. Seniority, city, employer size, industry, licensing, and language skills can move pay above or below these ranges.</p>
                <div class="content-table-wrap">
                  <table class="content-table">
                    <thead><tr><th>Role group</th><th>Typical gross range</th><th>How to use it</th></tr></thead>
                    <tbody>{profile.salaries.map((row) => <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td><td>Compare with visa rules, tax, rent, and relocation package.</td></tr>)}</tbody>
                  </table>
                </div>
              </section>
              <section class="content-block compact-content-block insight-box">
                <span class="mini-eyebrow">Offer analysis</span>
                <h2>Salary is only one part of relocation value</h2>
                <p>For international candidates, a good offer should be evaluated as a package: base salary, bonus, pension or retirement contributions, healthcare or insurance, relocation allowance, paid leave, visa support, probation risk, and long-term residence potential.</p>
                <div class="two-column-list"><div><strong>Strong signs</strong><ul><li>Clear salary range</li><li>Relocation or visa language</li><li>Market-level pay for the city</li><li>Benefits listed clearly</li></ul></div><div><strong>Questions to ask</strong><ul><li>Is sponsorship available for this role?</li><li>Is relocation assistance included?</li><li>What is the pay frequency?</li><li>Are benefits deducted from salary?</li></ul></div></div>
              </section>
            </>
          )}

          {section.slug === 'taxes' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Take-home planning</span>
                <h2>What can affect your net income</h2>
                <p>Tax pages should be used for planning, not final filing decisions. The same gross salary can produce very different monthly take-home pay depending on city, province/state, residency status, benefits, family status, and payroll deductions.</p>
                <div class="resource-analysis-grid">
                  {profile.tax.map((item) => <div class="analysis-card"><strong>{item}</strong><span>Use this as a research point before accepting an offer.</span></div>)}
                </div>
                <h3>Common items to compare</h3>
                <ul class="check-list"><li>Tax year and filing obligations</li><li>Income tax and local/provincial tax where applicable</li><li>Payroll deductions and social contributions</li><li>Sales tax or VAT/GST on daily spending</li><li>Benefits, pension, insurance, and family deductions</li></ul>
              </section>
              <section class="content-block compact-content-block insight-box">
                <span class="mini-eyebrow">Relocate Works insight</span>
                <h2>Do not compare countries by gross salary only</h2>
                <p>A role that looks lower-paid on paper may still be attractive if taxes, rent, healthcare, transport, and relocation support are favorable. Before applying heavily in {country.name}, build a simple net-income worksheet with salary, estimated tax, rent, monthly expenses, and one-time settlement costs.</p>
              </section>
            </>
          )}

          {section.slug === 'visas' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Pathway map</span>
                <h2>Visa and work-route concepts to research</h2>
                <p>The names and requirements can change, but the practical question stays the same: can the employer legally hire and support you for this role, at this salary, in this location?</p>
                <div class="content-table-wrap">
                  <table class="content-table">
                    <thead><tr><th>Pathway</th><th>Useful for</th><th>Employer role</th><th>Candidate note</th></tr></thead>
                    <tbody>{profile.visas.map((row) => <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td><td>{row[2]}</td><td>{row[3]}</td></tr>)}</tbody>
                  </table>
                </div>
              </section>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Sponsor signals</span>
                <h2>What to look for in job descriptions</h2>
                <div class="two-column-list"><div><strong>Positive signals</strong><ul class="check-list"><li>Visa sponsorship available</li><li>Work permit support</li><li>Relocation support or international hiring language</li><li>Employer listed as licensed/accredited/recognized where relevant</li><li>Salary range appears suitable for skilled work routes</li></ul></div><div><strong>Risk phrases</strong><ul><li>No sponsorship available</li><li>Must already have unrestricted work rights</li><li>Citizens or permanent residents only</li><li>Local candidates only</li><li>Remote role limited to one country</li></ul></div></div>
              </section>
            </>
          )}

          {section.slug === 'relocation-companies' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Service map</span>
                <h2>What relocation support can include</h2>
                <p>Relocation companies can help with the practical side of moving, but many candidates should first check what the employer already covers. Some offers include flights and temporary housing; others only support paperwork.</p>
                <div class="content-table-wrap">
                  <table class="content-table">
                    <thead><tr><th>Service</th><th>Planning range</th><th>When it matters</th></tr></thead>
                    <tbody>{profile.relocationCosts.map((row) => <tr><td><strong>{row[0]}</strong></td><td>{row[1]}</td><td>Costs vary by shipment size, family needs, city, and timing.</td></tr>)}</tbody>
                  </table>
                </div>
                <h3>Providers to research</h3>
                <div class="tag-cloud">{(country.relocationCompanies || listItems).map((item) => <span>{item}</span>)}</div>
              </section>
              <section class="content-block compact-content-block insight-box">
                <span class="mini-eyebrow">Questions to ask</span>
                <h2>Before paying for relocation help</h2>
                <ul class="check-list"><li>Does the employer provide a relocation allowance or vendor?</li><li>Is temporary accommodation included, and for how long?</li><li>Are flights, shipping, storage, pets, school search, or family support covered?</li><li>Is the service paid upfront or reimbursed after arrival?</li><li>What happens if the visa or start date is delayed?</li></ul>
              </section>
            </>
          )}

          {section.slug === 'jobs' && (
            <>
              <section class="content-block compact-content-block">
                <span class="mini-eyebrow">Market signals</span>
                <h2>Where sponsor-friendly jobs may appear</h2>
                <p>In {country.name}, stronger relocation opportunities usually appear in sectors where skills are scarce, employers hire internationally, and the role is senior or specialized enough to justify sponsorship effort.</p>
                <div class="info-grid two">
                  <div class="info-tile"><strong>Common sectors</strong><span>{country.sectors.join(', ')}</span></div>
                  <div class="info-tile"><strong>Role examples</strong><span>{country.demandJobs.join(', ')}</span></div>
                  <div class="info-tile"><strong>Best lead sources</strong><span>Official company career pages, sponsor lists where available, recruiter posts, and curated newsletters.</span></div>
                  <div class="info-tile"><strong>Application filter</strong><span>Prioritize roles with explicit sponsor language or no hard local-work-right requirement.</span></div>
                </div>
              </section>
              <section class="content-block compact-content-block insight-box">
                <span class="mini-eyebrow">Apply smarter</span>
                <h2>How to choose better roles</h2>
                <p>Do not apply randomly to every open position. Build a shortlist of roles where your experience, salary level, occupation category, employer credibility, and visa pathway make sense together.</p>
                <ul class="check-list"><li>Start with mid-level and senior roles unless your industry has strong shortage demand.</li><li>Use exact sponsor phrases in search, then remove jobs that say no sponsorship.</li><li>Match your CV headline and first page to the role category.</li><li>Track company, apply date, sponsor signal, and recruiter response.</li></ul>
              </section>
            </>
          )}

          <section class="content-block compact-content-block resource-checklist-block">
            <span class="mini-eyebrow">Planning checklist</span>
            <h2>Before making a decision about {country.name}</h2>
            <ul class="check-list">
              <li>Verify current official visa and work authorization rules.</li>
              <li>Check whether your occupation, salary, and experience level fit the likely pathway.</li>
              <li>Compare the offer with tax, rent, insurance, transport, and first-month settlement costs.</li>
              <li>Confirm employer support directly before spending time on long application steps.</li>
              <li>Keep documents ready: CV, certificates, references, transcripts, licenses, and language results where needed.</li>
            </ul>
            <p class="soft-disclaimer">{softDisclaimer}</p>
          </section>

          <section class="content-block cta-panel inline-substack-cta improved-inline-cta">
            <span class="mini-eyebrow">Weekly job intelligence</span>
            <h2>Want sponsor-friendly jobs for {country.name} and other countries?</h2>
            <p>Relocate Works publishes free previews and paid weekly sponsor-friendly job intelligence through Substack. Paid members get full lists with direct apply links, sponsor signals, relocation scores, salary notes when available, and practical planning notes.</p>
            <div class="pricing-mini-grid">
              <div><strong>$9/month</strong><span>Monthly access</span></div>
              <div><strong>$49/year</strong><span>Founding yearly access</span></div>
            </div>
            <div class="cta-actions-spaced">
              <a class="button" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Subscribe on Substack</a>
              <a class="button-light" href="/jobs/free-preview">View free job preview</a>
            </div>
          </section>

          <section class="content-block compact-content-block">
            <span class="mini-eyebrow">Related guides</span>
            <h2>Continue planning your move</h2>
            <div class="grid-3 related-compact-grid">
              {relatedPosts.map((post) => (
                <a class="article-card" href={`/blog/${post.slug}`}>
                  <div class="article-meta">{post.category} · {post.date}</div>
                  <h3>{post.title}</h3>
                  <p>{post.description}</p>
                  <span>Read guide →</span>
                </a>
              ))}
            </div>
          </section>
        </article>
      </div>
    </section>
    <CTA />
  </main>
  <Footer />
</BaseLayout>

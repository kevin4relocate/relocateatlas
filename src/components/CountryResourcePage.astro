    salaries: [['Software Engineer', 'EUR 60k–100k'], ['QA / Test Engineer', 'EUR 48k–80k'], ['Cloud / DevOps Engineer', 'EUR 70k–115k'], ['Data Engineer', 'EUR 60k–105k'], ['Mechanical Engineer', 'EUR 55k–90k'], ['Healthcare Specialist', 'EUR 45k–85k']],

    salaries: [['Software Engineer', 'SGD 75k–150k'], ['QA / Test Engineer', 'SGD 55k–100k'], ['Cloud / DevOps Engineer', 'SGD 90k–170k'], ['Data Analyst / Engineer', 'SGD 65k–140k'], ['Finance / Risk Analyst', 'SGD 65k–130k'], ['Product Manager', 'SGD 90k–170k']],
    tax: ['Income tax can be comparatively lower for some profiles, but housing can be very expensive.', 'Employment Pass eligibility depends on salary, qualifications, experience, and employer factors.', 'Budgeting should focus heavily on rent and family schooling if applicable.'],

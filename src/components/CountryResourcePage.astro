    monthly: [['Munich', 'EUR 2,400–4,100', 'High salaries but very high housing demand.'], ['Berlin', 'EUR 2,000–3,500', 'Strong tech market with rising rents.'], ['Frankfurt', 'EUR 2,100–3,700', 'Finance and corporate hub.'], ['Hamburg', 'EUR 1,900–3,300', 'Good professional market with moderate-to-high costs.']],

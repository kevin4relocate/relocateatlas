    currency: 'SGD',
    monthly: [['Central Singapore', 'SGD 4,000–7,000', 'Highest rent, strongest corporate density.'], ['East / West districts', 'SGD 3,200–5,500', 'Often more practical if commute works.'], ['North / suburban areas', 'SGD 2,800–4,800', 'Lower rent but commute should be checked.']],

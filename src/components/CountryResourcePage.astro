---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import CTA from './CTA.astro';
import CountryResourceNav from './CountryResourceNav.astro';
import { SITE, resourceSections, blogPosts } from '../data';
import { countryEditorial } from '../countryEditorial';
import { settlementNotes } from '../settlementEditorial';

const { country, sectionSlug } = Astro.props;
const editorial = countryEditorial[country.slug];
const settlement = settlementNotes[country.slug];
if (!editorial || !settlement) throw new Error('Country references missing for: ' + country.slug);

const section = resourceSections.find((item) => item.slug === sectionSlug);
if (!section) throw new Error(`Unknown resource section: ${sectionSlug}`);

const softDisclaimer =
  'Relocate Works helps you research sponsor-friendly opportunities faster. Final eligibility, visa support, and hiring decisions depend on each employer and official immigration rules.';

const profiles = {
  australia: {
    currency: 'AUD',
    monthly: [
      ['Sydney', 'AUD 3,600–5,600', 'Highest rent pressure, strongest finance and tech density.'],
      ['Melbourne', 'AUD 3,100–4,900', 'Strong job market with slightly different cost profile.'],

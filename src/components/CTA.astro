---
import { SITE } from '../data';
---
<section class="section cta-section">
  <div class="container">
    <div class="cta-band">
      <div>
        <span class="mini-eyebrow">Free weekly preview + founding paid access</span>
        <h2>Get sponsor-friendly jobs and relocation guides in your inbox.</h2>
        <p>
          Subscribe to Relocate Works on Substack for free previews, practical relocation notes, and paid weekly job intelligence at the founding price: $9/month or $49/year.
        </p>
      </div>
      <div class="cta-actions">
        <a class="button button-light" href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Subscribe on Substack</a>
        <a class="button-text-light" href="/jobs/free-preview">View free job preview</a>
      </div>
    </div>
  </div>
</section>

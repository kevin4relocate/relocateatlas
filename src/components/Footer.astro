---
import { SITE, countries } from '../data';
const year = new Date().getFullYear();
const destinations = countries.filter((country) => country.priority === 'Launch');
const guideLinks = [
  { href: '/guides', label: 'All relocation guides' },
  { href: '/visas', label: 'Visas & residence' },
  { href: '/salaries', label: 'Salaries' },
  { href: '/taxes', label: 'Taxes' },
  { href: '/cost-of-living', label: 'Living costs' }
];
const exploreLinks = [
  { href: '/remote-ai-jobs', label: 'AI Opportunities' },
  { href: '/countries', label: 'All countries' },
  { href: '/industries', label: 'Industries' },
  { href: '/jobs', label: 'Job-market guides' },
  { href: '/blog', label: 'Insights & articles' },
  { href: '/jobs/free-preview', label: 'Weekly job newsletter' },
  { href: '/pricing', label: 'Newsletter membership' }
];
---
<footer class="rw-footer">
  <div class="container rw-footer-top">
    <div class="rw-footer-brand">
      <a class="rw-brand rw-brand-inverse" href="/" aria-label="Relocate Works home">
        <img src="/brand-mark-blue.svg" width="42" height="42" alt="" aria-hidden="true" />
        <span class="rw-brand-wordmark">Relocate <strong>Works.</strong></span>
      </a>
      <p>Useful country research for people planning life and work abroad. Explore the guide library here; dated job roundups are published separately on Substack.</p>
      <div class="rw-footer-socials">
        <a href={SITE.substackUrl} target="_blank" rel="noopener noreferrer">Substack ↗</a>
        <a href={SITE.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={SITE.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
    <div class="rw-footer-col">
      <h2>Explore</h2>
      {exploreLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="rw-footer-col">
      <h2>Plan your move</h2>
      {guideLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="rw-footer-col">
      <h2>Destinations</h2>
      {destinations.map((country) => <a href={'/countries/' + country.slug}>{country.flag} {country.name}</a>)}
      <a href="/countries">More destinations →</a>
    </div>
  </div>
  <div class="container rw-footer-bottom">
    <span>© {year} Relocate Works.</span>
    <span>Independent informational research, not legal immigration advice.</span>
    <div><a href="/about">About</a><a href="/contact">Contact</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/disclaimer">Disclaimer</a></div>
  </div>
</footer>

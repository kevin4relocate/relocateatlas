---
type Props = {
  flag: string;
  name: string;
  slug: string;
  region?: string;
  primaryVisa: string;
  shortDescription: string;
  popularRoles?: readonly string[];
  priority?: 'Launch' | 'Next';
};
const { flag, name, slug, region = '', primaryVisa, shortDescription, popularRoles = [] } = Astro.props;
---
<a class="country-card rw-country-card" href={'/countries/' + slug}>
  <div class="rw-country-card-top">
    <span class="rw-flag" aria-hidden="true">{flag}</span>
    <span class="rw-country-region">{region || 'Destination guide'}</span>
    <span class="rw-country-arrow" aria-hidden="true">↗</span>
  </div>
  <h3>{name}</h3>
  <p class="rw-country-description">{shortDescription}</p>
  <div class="rw-country-card-bottom">
    <span class="rw-card-label">Visa route to research</span>
    <strong>{primaryVisa}</strong>
  </div>
  {popularRoles.length > 0 && (
    <div class="rw-country-roles" aria-label={name + ' example career sectors'}>
      {popularRoles.slice(0, 2).map((role) => <span>{role}</span>)}
    </div>
  )}
  <span class="rw-country-view">Explore country guide <span aria-hidden="true">→</span></span>
</a>
